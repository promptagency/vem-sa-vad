{
  "hooks": {
    "Stop": [
      { "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && { [ ! -f .claude/loop/active ] || node .claude/hooks/loop-stop.mjs; }", "timeout": 900 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && { [ ! -f .claude/loop/active ] || node .claude/hooks/guard-exam.mjs; }" }]
      }
    ]
  }
}
